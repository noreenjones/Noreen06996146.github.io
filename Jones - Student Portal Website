        /* ==========================================================================
           4. ACADEMIC CALCULATIONS (GPA, Letter Grades, Color Maps)
           ========================================================================== */
        function scoreToGradeInfo(score) {
            if (score >= 93) return { letter: "A", points: 4.0, badge: "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800" };
            if (score >= 90) return { letter: "A-", points: 3.7, badge: "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800" };
            if (score >= 87) return { letter: "B+", points: 3.3, badge: "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800" };
            if (score >= 83) return { letter: "B", points: 3.0, badge: "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800" };
            if (score >= 80) return { letter: "B-", points: 2.7, badge: "bg-indigo-50 text-indigo-700 border-indigo-200 dark:bg-indigo-950/60 dark:text-indigo-300 dark:border-indigo-800" };
            if (score >= 77) return { letter: "C+", points: 2.3, badge: "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800" };
            if (score >= 73) return { letter: "C", points: 2.0, badge: "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800" };
            if (score >= 70) return { letter: "C-", points: 1.7, badge: "bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/60 dark:text-orange-300 dark:border-orange-800" };
            if (score >= 60) return { letter: "D", points: 1.0, badge: "bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800" };
            return { letter: "F", points: 0.0, badge: "bg-rose-100 text-rose-800 border-rose-300 dark:bg-rose-950 dark:text-rose-300 dark:border-rose-800" };
        }

        function calculateGPA(courseList) {
            if (!courseList || courseList.length === 0) return "0.00";
            let totalPoints = 0;
            let totalCredits = 0;
            courseList.forEach(c => {
                const info = scoreToGradeInfo(c.currentScore);
                totalPoints += info.points * Number(c.credits);
                totalCredits += Number(c.credits);
            });
            return totalCredits > 0 ? (totalPoints / totalCredits).toFixed(2) : "0.00";
        }

