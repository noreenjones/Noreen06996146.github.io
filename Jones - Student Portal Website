        function openCourseModal(courseId) {
            const c = state.courses.find(item => item.id === courseId);
            if (!c) return;
            const styles = getCourseColorStyles(c.color);

            const codeBadge = document.getElementById("modal-course-code");
            codeBadge.textContent = `${c.code} • ${c.credits} Credits`;
            codeBadge.className = `inline-block px-2.5 py-1 rounded-lg text-xs font-bold tracking-wide uppercase mb-2 ${styles.pill}`;

            document.getElementById("modal-course-title").textContent = c.title;
            document.getElementById("modal-course-time").textContent = `${c.days.join(", ")} • ${c.startTime} - ${c.endTime}`;
            document.getElementById("modal-course-room").textContent = c.room;
            document.getElementById("modal-course-instructor").textContent = c.instructor;
            document.getElementById("modal-course-office").textContent = c.officeHours;
            document.getElementById("modal-course-syllabus").textContent = c.syllabus;
            document.getElementById("modal-course-email").textContent = c.email;

            const modal = document.getElementById("course-modal");
            modal.classList.remove("hidden");
            modal.classList.add("flex");
        }

        function closeCourseModal(e) {
            if (!e || e.target.id === "course-modal") {
                const modal = document.getElementById("course-modal");
                modal.classList.add("hidden");
                modal.classList.remove("flex");
