        /* -------------------- VIEW 3: GRADES & GPA -------------------- */
        function renderGrades() {
            const semesters = Object.keys(state.grades);
            const activeCourses = state.grades[selectedSemester] || [];
            const combinedForGPA = [...activeCourses, ...whatIfSimulations];
            const semesterGPA = calculateGPA(activeCourses);
            const simulatedGPA = calculateGPA(combinedForGPA);

            // Calculate cumulative GPA across all stored semesters
            const allStoredCourses = Object.values(state.grades).flat();
            const cumulativeGPA = calculateGPA(allStoredCourses);

            return `
            <div class="space-y-6 fade-in">
                <!-- Top Summary & Semester Selector -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
