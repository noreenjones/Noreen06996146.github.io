                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">${selectedSemester} GPA</span>
                        <div class="mt-2 flex items-baseline gap-3">
                            <span class="font-display font-bold text-3xl text-slate-900 dark:text-white">${semesterGPA}</span>
                            ${whatIfSimulations.length > 0 ? `
                                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300">
                                    What-If: ${simulatedGPA}
                                </span>
                            ` : ""}
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">${activeCourses.reduce((s, c) => s + c.credits, 0)} Graded Credits</p>
                    </div>

                    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800">
