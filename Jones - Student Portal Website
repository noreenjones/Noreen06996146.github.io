                        <div class="mt-2 flex items-baseline gap-2">
                            <span class="font-display font-bold text-3xl text-emerald-600 dark:text-emerald-400">${cumulativeGPA}</span>
                            <span class="text-xs text-slate-400">/ 4.00 Scale</span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Across ${allStoredCourses.length} total courses</p>
                    </div>
                </div>

                <!-- Grades Breakdown Table -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-xs">
                    <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <h3 class="font-display font-bold text-base text-slate-900 dark:text-white">${selectedSemester} Course Grades</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Adjust current scores inline to test grade impacts</p>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold uppercase tracking-wider text-slate-400 bg-slate-50/60 dark:bg-slate-800/40">
                                    <th class="py-3.5 px-5">Course</th>
                                    <th class="py-3.5 px-4">Instructor</th>
                                    <th class="py-3.5 px-4 text-center">Credits</th>
                                    <th class="py-3.5 px-4 text-center">Midterm</th>
                                    <th class="py-3.5 px-4">Current Score</th>
                                    <th class="py-3.5 px-4 text-center">Grade</th>
                                    <th class="py-3.5 px-5 text-right">Points</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                                ${activeCourses.map((c, idx) => {
                                    const info = scoreToGradeInfo(c.currentScore);
                                    return `
                                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30 transition-colors">
                                        <td class="py-4 px-5">
                                            <span class="font-bold text-brand-600 dark:text-brand-400 text-xs block">${escapeHTML(c.code)}</span>
                                            <span class="font-semibold text-slate-900 dark:text-white">${escapeHTML(c.title)}</span>
                                        </td>
                                        <td class="py-4 px-4 text-slate-600 dark:text-slate-300 text-xs">${escapeHTML(c.instructor)}</td>
                                        <td class="py-4 px-4 text-center font-medium">${c.credits}</td>
                                        <td class="py-4 px-4 text-center text-slate-500 dark:text-slate-400">${c.midterm}%</td>
                                        <td class="py-4 px-4">
                                            <div class="flex items-center gap-3">
                                                <input type="number" min="0" max="100" value="${c.currentScore}" onchange="updateCourseScore('${selectedSemester}', ${idx}, this.value)" class="w-16 px-2 py-1 rounded-lg text-xs font-bold bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                                <div class="w-24 h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden hidden sm:block">
                                                    <div class="h-full bg-brand-600 rounded-full transition-all" style="width: ${Math.min(100, Math.max(0, c.currentScore))}%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-4 text-center">
                                            <span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-bold border ${info.badge}">${info.letter}</span>
                                        </td>
                                        <td class="py-4 px-5 text-right font-semibold text-slate-700 dark:text-slate-200">${info.points.toFixed(1)}</td>
