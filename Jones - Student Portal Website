                            Timetable Grid
                        </button>
                        <button onclick="setScheduleLayout('list')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${
                            scheduleLayout === "list"
                            ? "bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs"
