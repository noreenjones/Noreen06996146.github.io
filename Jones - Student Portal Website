                            <option value="4" selected>4 Credits</option>
                            <option value="2">2 Credits</option>
                            <option value="1">1 Credit</option>
                        </select>
                        <input id="sim-score" type="number" min="0" max="100" required placeholder="Score (0-100)" value="95" class="sm:col-span-2 px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <button type="submit" class="sm:col-span-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold transition-colors">
                            Simulate
                        </button>
