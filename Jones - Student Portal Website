            whatIfSimulations = [];
            renderView();
        }

        /* -------------------- VIEW 4: ANNOUNCEMENTS -------------------- */
        function renderAnnouncements() {
            const categories = ["All", "Academic", "Campus Events", "Administrative", "Urgent"];
            const filtered = state.announcements.filter(a => {
                const matchesCat = announcementCategory === "All" || a.category === announcementCategory;
                const q = announcementSearch.toLowerCase();
                const matchesQuery = !q || a.title.toLowerCase().includes(q) || a.summary.toLowerCase().includes(q) || a.author.toLowerCase().includes(q);
                return matchesCat && matchesQuery;
            });

            const categoryStyles = {
                Academic: "bg-indigo-50 text-indigo-700 border-indigo-200 dark:bg-indigo-950/60 dark:text-indigo-300 dark:border-indigo-800",
                "Campus Events": "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800",
                Administrative: "bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700",
                Urgent: "bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800"
            };

            return `
            <div class="space-y-6 fade-in">
                <!-- Filter & Search Bar -->
                <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0">
                        ${categories.map(cat => `
                            <button onclick="setAnnouncementCategory('${cat}')" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${
                                announcementCategory === cat
                                ? "bg-brand-600 text-white shadow-xs"
                                : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-700"
                            }">
                                ${cat}
                            </button>
                        `).join("")}
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="relative flex-1 sm:w-64">
                            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <input type="text" value="${escapeHTML(announcementSearch)}" oninput="setAnnouncementSearch(this.value)" placeholder="Search announcements..." class="w-full pl-9 pr-3 py-1.5 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        </div>
                        <button onclick="markAllAnnouncementsRead()" class="px-3 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 whitespace-nowrap">
                            Mark all read
                        </button>
                    </div>
                </div>

                <!-- Feed List -->
                <div class="space-y-3.5">
                    ${filtered.length === 0 ? `
                        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-12 text-center">
                            <p class="text-slate-500 dark:text-slate-400 text-sm">No announcements match your current filter.</p>
                        </div>
                    ` : filtered.map(item => {
                        const isExpanded = expandedAnnouncementId === item.id;
                        const badgeClass = categoryStyles[item.category] || categoryStyles.Administrative;
                        return `
                        <div class="bg-white dark:bg-slate-900 rounded-2xl border transition-all ${
                            item.read
                            ? "border-slate-200/80 dark:border-slate-800"
                            : "border-brand-300 dark:border-brand-700/80 shadow-xs"
                        }">
                            <div class="p-5 cursor-pointer" onclick="toggleExpandAnnouncement(${item.id})">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                                    <div class="flex items-center gap-2.5">
                                        ${!item.read ? `<span class="w-2.5 h-2.5 rounded-full bg-brand-600 shrink-0" title="Unread"></span>` : ""}
                                        <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold border ${badgeClass}">${escapeHTML(item.category)}</span>
                                        <span class="text-xs text-slate-400">${escapeHTML(item.date)} • ${escapeHTML(item.author)}</span>
                                    </div>
                                    <button onclick="event.stopPropagation(); toggleReadStatus(${item.id})" class="self-start sm:self-auto text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                                        ${item.read ? "Mark as unread" : "Mark as read"}
                                    </button>
                                </div>
                                <h3 class="font-display font-bold text-base sm:text-lg text-slate-900 dark:text-white">${escapeHTML(item.title)}</h3>
                                <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">${escapeHTML(item.summary)}</p>

                                ${isExpanded ? `
                                    <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 text-sm text-slate-700 dark:text-slate-300 leading-relaxed fade-in">
                                        ${escapeHTML(item.content)}
                                    </div>
                                ` : `
                                    <div class="mt-2.5 text-xs font-semibold text-slate-400 flex items-center gap-1">
                                        <span>Click to read full notice</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                    </div>
                                `}
                            </div>
                        </div>
                        `;
                    }).join("")}
                </div>
            </div>
            `;
        }

        function setAnnouncementCategory(cat) {
            announcementCategory = cat;
            renderView();
        }

        function setAnnouncementSearch(val) {
            announcementSearch = val;
            renderView();
        }

        function toggleExpandAnnouncement(id) {
            expandedAnnouncementId = expandedAnnouncementId === id ? null : id;
            const item = state.announcements.find(a => a.id === id);
            if (item && !item.read) {
                item.read = true;
                saveState();
            }
            renderView();
        }

        function toggleReadStatus(id) {
            const item = state.announcements.find(a => a.id === id);
            if (item) {
                item.read = !item.read;
                saveState();
                renderView();
            }
        }

        function markAllAnnouncementsRead() {
            state.announcements.forEach(a => a.read = true);
            saveState();
            renderView();
            showToast("All announcements marked as read", "success");
        }

        /* -------------------- VIEW 5: STUDENT PROFILE -------------------- */
        function renderProfile() {
            const p = state.profile;
            const initials = p.name.split(" ").map(n => n[0]).join("").slice(0, 2).toUpperCase();
            const progressPct = Math.min(100, Math.round((p.creditsCompleted / p.creditsRequired) * 100));

            return `
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 fade-in">
                <!-- Left Column: Digital Student ID Card & Degree Progress (5 cols) -->
                <div class="lg:col-span-5 space-y-6">
                    <!-- Digital Student ID Card -->
                    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 text-white p-6 shadow-xl border border-slate-700/60">
                        <div class="flex items-center justify-between pb-5 border-b border-white/10">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center font-display font-bold text-sm">N</div>
                                <div>
                                    <span class="font-display font-bold text-sm tracking-wide block">NEXUS UNIVERSITY</span>
                                    <span class="text-[10px] uppercase tracking-widest text-indigo-300">Official Student ID</span>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">Active</span>
                        </div>

                        <div class="mt-6 flex items-center gap-4">
                            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-500 to-violet-500 flex items-center justify-center font-display font-bold text-2xl shadow-inner shrink-0">
                                ${initials || "ST"}
                            </div>
                            <div class="min-w-0">
                                <h3 class="font-display font-bold text-xl truncate">${escapeHTML(p.name)}</h3>
                                <p class="text-xs text-indigo-200 mt-0.5">${escapeHTML(p.major)}</p>
                                <p class="text-xs text-slate-400 mt-0.5">${escapeHTML(p.year)}</p>
                            </div>
                        </div>

                        <div class="mt-6 pt-5 border-t border-white/10 grid grid-cols-2 gap-4 text-xs">
                            <div>
                                <span class="text-slate-400 block">Student ID Number</span>
                                <span class="font-mono font-bold text-sm text-white mt-0.5 block">${escapeHTML(p.studentId)}</span>
                            </div>
                            <div>
                                <span class="text-slate-400 block">Faculty Advisor</span>
                                <span class="font-semibold text-white mt-0.5 block">${escapeHTML(p.advisor)}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Degree Completion Progress Card -->
                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-xs">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="font-display font-bold text-base text-slate-900 dark:text-white">Degree Progress</h4>
                            <span class="font-display font-bold text-sm text-brand-600 dark:text-brand-400">${progressPct}%</span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">${p.creditsCompleted} of ${p.creditsRequired} credits completed toward graduation</p>
                        
                        <div class="w-full h-3 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-brand-600 to-indigo-500 rounded-full transition-all duration-500" style="width: ${progressPct}%"></div>
                        </div>

                        <div class="mt-4 grid grid-cols-3 gap-2 text-center pt-4 border-t border-slate-100 dark:border-slate-800">
                            <div>
                                <span class="font-display font-bold text-lg text-slate-900 dark:text-white block">${p.creditsCompleted}</span>
                                <span class="text-[11px] text-slate-400">Earned</span>
                            </div>
                            <div>
                                <span class="font-display font-bold text-lg text-brand-600 dark:text-brand-400 block">17</span>
                                <span class="text-[11px] text-slate-400">In Progress</span>
                            </div>
                            <div>
                                <span class="font-display font-bold text-lg text-slate-900 dark:text-white block">${Math.max(0, p.creditsRequired - p.creditsCompleted - 17)}</span>
                                <span class="text-[11px] text-slate-400">Remaining</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Editable Profile Form (7 cols) -->
                <div class="lg:col-span-7 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-xs">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-5 border-b border-slate-100 dark:border-slate-800">
                        <div>
                            <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white">Personal & Contact Information</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Changes persist locally in your browser storage</p>
                        </div>
                        <button type="button" onclick="resetDemoData()" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/50 hover:bg-rose-100 dark:hover:bg-rose-950 transition-colors self-start">
                            Reset Demo Data
                        </button>
                    </div>

                    <form onsubmit="saveProfileForm(event)" class="mt-5 space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Full Name</label>
                                <input id="prof-name" type="text" required value="${escapeHTML(p.name)}" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">University Email</label>
                                <input id="prof-email" type="email" required value="${escapeHTML(p.email)}" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Phone Number</label>
                                <input id="prof-phone" type="text" value="${escapeHTML(p.phone)}" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Campus Residence / Address</label>
                                <input id="prof-location" type="text" value="${escapeHTML(p.location)}" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Primary Major</label>
                                <input id="prof-major" type="text" value="${escapeHTML(p.major)}" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Academic Year</label>
                                <input id="prof-year" type="text" value="${escapeHTML(p.year)}" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Student Bio & Academic Interests</label>
                            <textarea id="prof-bio" rows="3" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">${escapeHTML(p.bio)}</textarea>
                        </div>

                        <div class="pt-2 flex justify-end">
                            <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition-colors">
                                Save Profile Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            `;
        }

        function saveProfileForm(e) {
            e.preventDefault();
            state.profile.name = document.getElementById("prof-name").value.trim() || state.profile.name;
            state.profile.email = document.getElementById("prof-email").value.trim() || state.profile.email;
            state.profile.phone = document.getElementById("prof-phone").value.trim();
            state.profile.location = document.getElementById("prof-location").value.trim();
            state.profile.major = document.getElementById("prof-major").value.trim();
            state.profile.year = document.getElementById("prof-year").value.trim();
            state.profile.bio = document.getElementById("prof-bio").value.trim();

            saveState();
            updateSidebarProfile();
            renderView();
            showToast("Profile updated and saved locally", "success");
        }

        /* ==========================================================================
           6. INITIALIZATION
           ========================================================================== */
        window.addEventListener("DOMContentLoaded", () => {
            initTheme();
            updateUnreadBadges();
            updateSidebarProfile();
            switchView("dashboard");
        });
    </script>
</body>
