        function handleAddTask(e) {
            e.preventDefault();
            const input = document.getElementById("new-task-input");
            const course = document.getElementById("new-task-course").value;
            const due = document.getElementById("new-task-due").value.trim();
            const title = input.value.trim();
            if (!title) return;

            state.tasks.unshift({
                id: Date.now(),
                title,
                course,
                due: due || "Upcoming",
                completed: false
            });
            saveState();
            renderView();
            showToast("Assignment added to tracker", "success");
        }

        function toggleTask(id) {
            const task = state.tasks.find(t => t.id === id);
            if (task) {
                task.completed = !task.completed;
                saveState();
                renderView();
            }
        }

        function deleteTask(id) {
            state.tasks = state.tasks.filter(t => t.id !== id);
            saveState();
            renderView();
            showToast("Task removed");
        }

        function openAnnouncementFromDashboard(id) {
            expandedAnnouncementId = id;
            const item = state.announcements.find(a => a.id === id);
            if (item && !item.read) {
                item.read = true;
                saveState();
            }
            switchView("announcements");
        }

