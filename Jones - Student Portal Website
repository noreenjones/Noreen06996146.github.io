                                }).join("")}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Interactive "What-If" GPA Simulator -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-xs">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                        <div>
                            <h3 class="font-display font-bold text-base text-slate-900 dark:text-white">"What-If" GPA Simulator</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Add hypothetical courses to see how future grades affect your term GPA</p>
                        </div>
                        ${whatIfSimulations.length > 0 ? `
                            <button onclick="clearWhatIf()" class="text-xs font-semibold text-rose-600 hover:underline self-start">Clear Simulations</button>
                        ` : ""}
                    </div>

                    <form onsubmit="addWhatIfCourse(event)" class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                        <input id="sim-title" type="text" required placeholder="Hypothetical Course (e.g., CS-410 Machine Learning)" class="sm:col-span-6 px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
