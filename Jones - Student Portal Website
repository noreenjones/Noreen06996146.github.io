        function updateCourseScore(semester, index, newScore) {
            const parsed = Math.min(100, Math.max(0, Number(newScore) || 0));
            state.grades[semester][index].currentScore = parsed;
            saveState();
            renderView();
            showToast("Score updated & GPA recalculated", "success");
        }

        function addWhatIfCourse(e) {
            e.preventDefault();
            const title = document.getElementById("sim-title").value.trim();
            const credits = Number(document.getElementById("sim-credits").value);
            const currentScore = Math.min(100, Math.max(0, Number(document.getElementById("sim-score").value)));
            if (!title) return;

            whatIfSimulations.push({ title, credits, currentScore });
            renderView();
        }

        function removeWhatIf(idx) {
            whatIfSimulations.splice(idx, 1);
            renderView();
        }

