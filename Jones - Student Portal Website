                                const info = scoreToGradeInfo(sim.currentScore);
                                return `
                                <div class="flex items-center justify-between p-3 rounded-xl bg-brand-50/50 dark:bg-brand-950/30 border border-brand-200/60 dark:border-brand-800/50 text-sm">
                                    <div>
                                        <span class="font-semibold text-slate-900 dark:text-white">${escapeHTML(sim.title)}</span>
                                        <span class="text-xs text-slate-500 ml-2">(${sim.credits} Credits • ${sim.currentScore}% → ${info.letter})</span>
                                    </div>
                                    <button onclick="removeWhatIf(${idx})" class="text-xs font-semibold text-rose-600 hover:underline">Remove</button>
                                </div>
                                `;
                            }).join("")}
                        </div>
                    ` : ""}
                </div>
            </div>
            `;
        }

        function selectSemester(sem) {
            selectedSemester = sem;
            renderView();
        }

        function updateCourseScore(semester, index, newScore) {
            const parsed = Math.min(100, Math.max(0, Number(newScore) || 0));
            state.grades[semester][index].currentScore = parsed;
            saveState();
            renderView();
            showToast("Score updated & GPA recalculated", "success");
        }

        function addWhatIfCourse(e) {
            e.preventDefault();
            const title = document.getElementById("sim-title").value.trim();
            const credits = Number(document.getElementById("sim-credits").value);
            const currentScore = Math.min(100, Math.max(0, Number(document.getElementById("sim-score").value)));
            if (!title) return;

            whatIfSimulations.push({ title, credits, currentScore });
            renderView();
        }

        function removeWhatIf(idx) {
            whatIfSimulations.splice(idx, 1);
            renderView();
        }

        function clearWhatIf() {
            whatIfSimulations = [];
            renderView();
        }

        /* -------------------- VIEW 4: ANNOUNCEMENTS -------------------- */
        function renderAnnouncements() {
            const categories = ["All", "Academic", "Campus Events", "Administrative", "Urgent"];
            const filtered = state.announcements.filter(a => {
                const matchesCat = announcementCategory === "All" || a.category === announcementCategory;
                const q = announcementSearch.toLowerCase();
                const matchesQuery = !q || a.title.toLowerCase().includes(q) || a.summary.toLowerCase().includes(q) || a.author.toLowerCase().includes(q);
                return matchesCat && matchesQuery;
            });

            const categoryStyles = {
                Academic: "bg-indigo-50 text-indigo-700 border-indigo-200 dark:bg-indigo-950/60 dark:text-indigo-300 dark:border-indigo-800",
                "Campus Events": "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800",
                Administrative: "bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700",
                Urgent: "bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800"
            };

            return `
            <div class="space-y-6 fade-in">
                <!-- Filter & Search Bar -->
                <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0">
                        ${categories.map(cat => `
                            <button onclick="setAnnouncementCategory('${cat}')" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${
                                announcementCategory === cat
                                ? "bg-brand-600 text-white shadow-xs"
                                : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-700"
                            }">
                                ${cat}
                            </button>
                        `).join("")}
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="relative flex-1 sm:w-64">
                            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <input type="text" value="${escapeHTML(announcementSearch)}" oninput="setAnnouncementSearch(this.value)" placeholder="Search announcements..." class="w-full pl-9 pr-3 py-1.5 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        </div>
                        <button onclick="markAllAnnouncementsRead()" class="px-3 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 whitespace-nowrap">
                            Mark all read
                        </button>
                    </div>
                </div>

                <!-- Feed List -->
                <div class="space-y-3.5">
                    ${filtered.length === 0 ? `
                        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-12 text-center">
                            <p class="text-slate-500 dark:text-slate-400 text-sm">No announcements match your current filter.</p>
                        </div>
                    ` : filtered.map(item => {
                        const isExpanded = expandedAnnouncementId === item.id;
                        const badgeClass = categoryStyles[item.category] || categoryStyles.Administrative;
                        return `
                        <div class="bg-white dark:bg-slate-900 rounded-2xl border transition-all ${
                            item.read
                            ? "border-slate-200/80 dark:border-slate-800"
                            : "border-brand-300 dark:border-brand-700/80 shadow-xs"
                        }">
                            <div class="p-5 cursor-pointer" onclick="toggleExpandAnnouncement(${item.id})">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                                    <div class="flex items-center gap-2.5">
                                        ${!item.read ? `<span class="w-2.5 h-2.5 rounded-full bg-brand-600 shrink-0" title="Unread"></span>` : ""}
                                        <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold border ${badgeClass}">${escapeHTML(item.category)}</span>
                                        <span class="text-xs text-slate-400">${escapeHTML(item.date)} • ${escapeHTML(item.author)}</span>
                                    </div>
                                    <button onclick="event.stopPropagation(); toggleReadStatus(${item.id})" class="self-start sm:self-auto text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                                        ${item.read ? "Mark as unread" : "Mark as read"}
                                    </button>
                                </div>
                                <h3 class="font-display font-bold text-base sm:text-lg text-slate-900 dark:text-white">${escapeHTML(item.title)}</h3>
                                <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">${escapeHTML(item.summary)}</p>

                                ${isExpanded ? `
                                    <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 text-sm text-slate-700 dark:text-slate-300 leading-relaxed fade-in">
                                        ${escapeHTML(item.content)}
                                    </div>
                                ` : `
                                    <div class="mt-2.5 text-xs font-semibold text-slate-400 flex items-center gap-1">
                                        <span>Click to read full notice</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                    </div>
                                `}
                            </div>
                        </div>
                        `;
                    }).join("")}
                </div>
            </div>
            `;
        }

        function setAnnouncementCategory(cat) {
            announcementCategory = cat;
            renderView();
        }

        function setAnnouncementSearch(val) {
            announcementSearch = val;
            renderView();
        }

        function toggleExpandAnnouncement(id) {
            expandedAnnouncementId = expandedAnnouncementId === id ? null : id;
            const item = state.announcements.find(a => a.id === id);
            if (item && !item.read) {
                item.read = true;
                saveState();
            }
            renderView();
        }

        function toggleReadStatus(id) {
            const item = state.announcements.find(a => a.id === id);
            if (item) {
                item.read = !item.read;
                saveState();
                renderView();
            }
        }

        function markAllAnnouncementsRead() {
            state.announcements.forEach(a => a.read = true);
            saveState();
            renderView();
            showToast("All announcements marked as read", "success");
        }

        /* -------------------- VIEW 5: STUDENT PROFILE -------------------- */
        function renderProfile() {
            const p = state.profile;
            const initials = p.name.split(" ").map(n => n[0]).join("").slice(0, 2).toUpperCase();
            const progressPct = Math.min(100, Math.round((p.creditsCompleted / p.creditsRequired) * 100));

