                            <textarea id="prof-bio" rows="3" class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500">${escapeHTML(p.bio)}</textarea>
                        </div>

                        <div class="pt-2 flex justify-end">
                            <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition-colors">
                                Save Profile Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            `;
        }

        function saveProfileForm(e) {
            e.preventDefault();
            state.profile.name = document.getElementById("prof-name").value.trim() || state.profile.name;
            state.profile.email = document.getElementById("prof-email").value.trim() || state.profile.email;
            state.profile.phone = document.getElementById("prof-phone").value.trim();
            state.profile.location = document.getElementById("prof-location").value.trim();
            state.profile.major = document.getElementById("prof-major").value.trim();
            state.profile.year = document.getElementById("prof-year").value.trim();
            state.profile.bio = document.getElementById("prof-bio").value.trim();

            saveState();
            updateSidebarProfile();
            renderView();
            showToast("Profile updated and saved locally", "success");
        }

        /* ==========================================================================
           6. INITIALIZATION
           ========================================================================== */
        window.addEventListener("DOMContentLoaded", () => {
            initTheme();
            updateUnreadBadges();
            updateSidebarProfile();
            switchView("dashboard");
        });
    </script>
</body>
</html>
